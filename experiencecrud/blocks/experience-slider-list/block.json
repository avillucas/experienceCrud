{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ec/experience-slider-list",
  "version": "1.0.0",
  "title": "Experience Slider List",
  "category": "widgets",
  "icon": "slides",
  "description": "Selector de thumbnails con panel de detalle por experiencia.",
  "supports": {
    "html": false,
    "anchor": true
  },
  "attributes": {
    "introLogoUrl": {
      "type": "string",
      "default": ""
    },
    "introText": {
      "type": "string",
      "default": ""
    },
    "introBookingUrl": {
      "type": "string",
      "default": "https://catenazapata.meitre.com/"
    },
    "introEmail": {
      "type": "string",
      "default": "turismo@catenazapata.com"
    }
  },
  "textdomain": "experience-crud",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./render.php"
}